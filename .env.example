NOTION_API_KEY=ntn_여기에_Integration_Secret_붙여넣기

# Supabase Postgres index (run supabase_schema.sql once in Supabase SQL Editor)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-private-backend-key

# Google Drive (service account) - either a local file path or inline JSON content
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Remote deployment only (leave unset for local stdio use with Claude Code/Codex)
# MCP_TRANSPORT=streamable-http
# MEMBERS_JSON={"ghbot_xxx":"member name"}
